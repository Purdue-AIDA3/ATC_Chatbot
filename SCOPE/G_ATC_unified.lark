// ═══════════════════════════════════════════════════════════════════════════
// G_ATC_unified  —  SCOPE ATC Phraseology Grammar  v3
// ═══════════════════════════════════════════════════════════════════════════
//
// Regulatory authority:
//   ICAO Doc 4444 (16th ed., 2016) — Chapter 12 (phraseology)
//   FAA JO 7110.65BB               — US ATC procedures and phraseology
//   ICAO Doc 8585 / FAA Order 7340.2 — Telephony designators
//   ICAO Annex 10                  — NATO phonetic alphabet
//
// Construction:
//   Specification-first (specification-grounded): all production rules
//   phraseology sections of the regulatory documents listed above.
//   No corpus frequency filter applied; the grammar encodes what the
//   standard prescribes, not only what the 1994 LDC corpus attests.
//
//   Corpus-validated: validated against 500 utterances independently
//   corrected by a certified ATC controller (mixed role: 296 controller,
//   204 pilot). Seven rounds of targeted grammar revision, each fix
//   traceable to a specific ICAO Doc 4444 section.
//
//   Human compliance ceiling (role-gated strict parsing):
//     383/500 = 76.6%  overall
//     224/296 = 75.7%  controller (start='controller_utterance')
//     159/204 = 77.9%  pilot      (start='pilot_utterance')
//     240/314 = 76.4%  confidence ≥ 6
//     113/149 = 75.8%  confidence = 7
//
//   The 23.8% gap decomposes as:
//     ~10% complex instruction chains — missing ICAO sub-expression
//          forms (AT OR ABOVE, UNTIL DME, SPEED NOT ABOVE, traffic
//          direction forms) that are fixable with further revision.
//          Note: chain depth is not the limit — instruction_chain
//          allows unlimited chaining; failures are sub-expression gaps.
//     ~5%  DCA/BOS local procedures not codified in ICAO Doc 4444
//          (RIVER visual approach, DAVISON runway, bridge landmarks).
//     ~4%  1994 corpus operational practice diverging from 2016 standard
//          (correct rejections: grouped-digit callsign pronunciation,
//           informal phrases, disfluencies). Note: ICAO §12.2.1 mandates
//           individual digit pronunciation; grouped digits (THIRTY, NINETY
//           etc.) are excluded from number_word on this basis.
//     ~5%  Additional ICAO sub-expression forms identified but not
//          yet encoded (further post-paper grammar work).
//
// Two-party structure:
//   ATC radio communication is a two-party dialogue. The grammar encodes
//   both roles as distinct named sub-grammars under a unified top-level
//   dispatch, enabling role-gated compliance checking.
//
//   Key structural distinction:
//     Controller: [callsign] instruction_chain  (callsign BEFORE content)
//     Pilot:      pilot_report | readback | request | contact
//                 Includes: callsign + action (callsign at START),
//                           action + callsign (callsign at END),
//                           bare callsign acknowledgement.
//
// Structure:
//   §1  Top-level dispatch    — controller_utterance | pilot_utterance
//   §2  Controller body       — facility self-ID + instruction chain
//   §3  Instruction types
//         §3.1  Altitude / Level    (ICAO Doc 4444 §12.3.1–12.3.5)
//                  incl. AT OR ABOVE/BELOW, UNTIL DME/waypoint
//         §3.2  Heading / Track     (ICAO Doc 4444 §12.3.6)
//                  incl. CONTINUE TURN, AFTER waypoint, VOR RADIAL
//         §3.3  Speed               (ICAO Doc 4444 §12.3.7)
//                  incl. SPEED NOT ABOVE/BELOW, MAINTAIN OR GREATER
//         §3.4  Frequency / Contact (ICAO Doc 4444 §12.4.2)
//         §3.5  Clearance           (ICAO Doc 4444 §12.5 and §12.7)
//                  incl. runway-first forms, TAKE-OFF hyphen variant
//         §3.6  Taxi                (ICAO Doc 4444 §12.6)
//                  incl. runway-first LINE UP AND WAIT, CROSS RUNWAY,
//                        VACATE, progressive LINING UP AND WAITING
//         §3.7  Takeoff             (ICAO Doc 4444 §12.7)
//         §3.8  Approach            (ICAO Doc 4444 §12.8)
//         §3.9  Holding             (ICAO Doc 4444 §12.9)
//         §3.10 Traffic information (ICAO Doc 4444 §12.3.10)
//                  incl. progressive direction (TURNING SOUTHBOUND),
//                        FROM TOUCHDOWN, TRAFFIC WILL LAND/DEPART
//         §3.10b Surface wind       (ICAO Doc 4444 §12.8)
//         §3.11 Transponder / Radar (ICAO Doc 4444 §12.3.11)
//                  incl. RADAR SERVICE TERMINATED
//         §3.12 Position reports    (ICAO Doc 4444 §12.4.1)
//         §3.13 Confirmation        (ICAO Doc 4444 §12.4.4)
//                  incl. CONFIRM SPEED/ALTITUDE value, SAY LEVEL/HEADING
//         §3.14 Route / Airway      (ICAO Doc 4444 §12.3.8)
//                  incl. VOR radial intercept, phonetic waypoints
//         §3.15 ATIS identifier     (ICAO Doc 4444 §12.2.2)
//         §3.16 Altitude departure  — LEAVING level (bare form)
//   §4  Shared terminals      — level, heading, speed, frequency,
//                               callsign, waypoint, runway, number words,
//                               until_cond, progressive_traffic_desc
//   §5  Pilot utterances      — readback, report, request, contact
//                               (ICAO Doc 4444 §12.4)
//                  incl. pilot_action_report (progressive position report),
//                        bare callsign ack, RUNWAY id IN SIGHT/VACATED,
//                        READY FOR DEPARTURE, LINING UP AND WAITING,
//                        HEADING AFTER waypoint, WILCO + instruction
//   §6  Catch-all fallback    — disabled in strict mode
//
// Parsing modes:
//   Strict     — general_instr and pilot_general disabled.
//                Used for compliance metric computation (C_cfg).
//                Build with the strict parser builder in SCOPE codebase.
//   Permissive — all rules active.
//                Used for training signal and coverage analysis.
//
// Role-gated entry points:
//   Controller → start='controller_utterance'
//                Validates controller instructions and transmissions.
//                Accepts: [callsign] [facility_self_id] instruction_chain
//                         callsign + facility_name (controller self-ID)
//                         callsign alone (bare acknowledgement)
//   Pilot      → start='pilot_utterance'
//                Validates pilot readbacks, reports, requests, contacts.
//                Accepts multiple structural forms — callsign position
//                varies by utterance type (see §5).
//   Unified    → start='start'
//                Accepts either role; used for corpus coverage analysis.
//
// Callsign coverage:
//   Telephony designators enumerated from ICAO Doc 8585 and
//   FAA Order 7340.2. NATO phonetic alphabet (ICAO Annex 10) included
//   for phonetic callsigns and airway identifiers. Single-letter
//   terminals /[A-Z]/ cover callsign components (e.g. T W A).
//   Phonetically-spoken waypoints covered via spaced-letter regex
//   (e.g. D F W for DFW VOR).
//
// Design decisions:
//   - Regex terminals (/[A-Z]{3,10}/, /[0-9]{3}/) handle open-ended
//     identifiers (waypoints, headings) without full enumeration.
//   - Space-separated terminals throughout (no multi-word strings),
//     for consistency and rule inspectability.
//   - GOOD DAY is the ICAO-standard time-of-day greeting (Doc 4444
//     §12.4.2); GOOD MORNING/AFTERNOON/EVENING are excluded.
//   - Catch-all rules (general_instr, pilot_general) provide training
//     signal for non-covered utterances; always disabled for C_cfg.
// ═══════════════════════════════════════════════════════════════════════════


// ── §1  TOP-LEVEL UTTERANCE DISPATCH ──────────────────────────────────────

// Entry point: select role explicitly via start= parameter
//   Controller: start='controller_utterance'
//   Pilot:      start='pilot_utterance'
//   Either:     start='start' (unified, for permissive parsing)
start : controller_utterance
      | pilot_utterance

// ── Controller utterance top level ────────────────────────────────────────
// A controller transmission optionally addresses a specific callsign,
// then delivers one or more instructions.
// Ref: ICAO Doc 4444 §12.1
controller_utterance : callsign_phrase " " body   // addressed: "DELTA SIX TURN LEFT..."
                     | body                        // unaddressed: "TURN LEFT HEADING..."
                     | callsign_phrase             // bare acknowledgement: "DELTA SIX ROGER"

// ── §2  CONTROLLER UTTERANCE BODY ─────────────────────────────────────────
// Rules shared by controller_utterance. Entry: start='controller_utterance'

// Body: optional facility self-identification, then one or more instructions.
// body: optional facility self-ID, then one or more instructions.
// body: optional facility self-ID, then one or more instructions.
body : facility_ack " " instruction_chain
     | instruction_chain
     | facility_name              // controller self-ID: e.g. "[callsign] REGIONAL APPROACH"
// Facility self-identification (e.g. "BOSTON APPROACH ROGER")
// Used when controller identifies their position before issuing clearance.
facility_ack : facility_name " " acknowledgment
             | facility_name
             | acknowledgment

// facility_name: one or two facility words (city + role).
// Uses facility_word to prevent over-broad regex matches like
// "NINETEEN REGIONAL APPROACH" being consumed as a facility name.
// facility_name: one or two facility words (city + role).
// Composes from facility_word to prevent over-broad regex matches.
facility_name : facility_word (" " facility_word)?

acknowledgment : "ROGER" | "WILCO" | "AFFIRM" | "NEGATIVE" | "UNABLE"
               | "GOOD DAY" | "HAVE A GOOD DAY"
               | "THANK YOU" | "THANKS"

// Instruction chain: one or more instructions optionally joined by AND.
// Leading acknowledgement allowed (e.g. "ROGER DESCEND AND MAINTAIN...").
instruction_chain : ack_only " " instruction (" " ("AND " )? instruction)*
                  | instruction (" " ("AND " )? instruction)*

// Acknowledgement-only body items.
ack_only : acknowledgment
         | "LOOKING OUT"             // visual separation acquired
         | "NEGATIVE CONTACT"        // traffic not in sight
         | "NEGATIVE RADAR CONTACT"
         | "SAY SQUAWK"              // controller requesting transponder code
         | "SAY AGAIN"               // request for repeat (ICAO Doc 4444 §12.4.4)
         | "SAY" " " "LEVEL"
         | "SAY" " " "ALTITUDE"
         | "SAY" " " "HEADING"
         | "SAY" " " "SPEED"
         | "SAY" " " "INTENTIONS"
         | "SAY" " " "REQUESTED" " " ("ALTITUDE" | "HEADING" | "SPEED")
         | "RADIO" " " "CHECK"
         | "HOW" " " "DO" " " "YOU" " " "READ"
         | "STANDBY"                 // instruction to wait
         | "READBACK CORRECT"        // controller confirms pilot readback
         | "CORRECTION"              // mid-utterance self-correction marker


// ── §3  INSTRUCTION TYPES ──────────────────────────────────────────────────

instruction : altitude_instr
            | heading_instr
            | speed_instr
            | frequency_instr
            | clearance_instr
            | taxi_instr
            | takeoff_instr
            | approach_instr
            | hold_instr
            | traffic_instr
            | ident_instr
            | report_instr
            | confirm_instr
            | route_instr
            | information_instr
            | leaving_instr
            | surface_wind_instr
            | radar_contact_instr
            | ack_only
            | general_instr          // disabled in strict mode


// §3.1  Altitude / Level instructions
// Ref: ICAO Doc 4444 §12.3.1–12.3.5

altitude_instr : climb_descend_instr
               | "MAINTAIN" " " level
               | "MAINTAIN" " " "AT" " " "OR" " " ("ABOVE" | "BELOW") " " level (" " "UNTIL" " " until_cond)?
               | "MAINTAIN" " " level " " "UNTIL" " " until_cond
               | "MAINTAIN" " " "FLIGHT" " " "LEVEL" " " fl_value
               | "MAINTAIN" " " "VISUAL" " " "SEPARATION" " " ("FROM" " " report_type)?
               | "CROSS" " " waypoint " " ("AT" " ")? level (" " "OR" " " "ABOVE")?
               | "EXPECT" " " level
               | "EXPECT" " " "FURTHER" " " ("DESCENT" | "CLIMB") " " "IN" " " number_word (" " number_word)* " " "MILES"
               | "DESCEND" " " "TO" " " level (" " "WITHOUT" " " "DELAY")?
               | "LEAVING" " " level   // departure level report (ICAO §12.4.3)
               | "CLIMB" " " "TO" " " level
               | "STOP" " " climb_descend " " "AT" " " level
               | "LEVEL" " " ("AT" " ")? level
               | "LEVEL" " " "OFF"
               | "CLIMBING" " " "TO" " " level
               | "DESCENDING" " " "TO" " " level
               | "CLIMBING" " " "AND" " " "MAINTAINING" " " level
               | "DESCENDING" " " "FROM" " " level
               | "MAINTAINING" " " level
               | "EXPEDITE" " " ("CLIMB" | "DESCENT") (" " "THROUGH" " " level)?
               | "EXPEDITE" " " climb_descend_instr
               | "EXPEDITING" " " ("CLIMB" | "DESCENT") (" " "THROUGH" " " level)?

climb_descend_instr : climb_descend " " "AND" " " "MAINTAIN" " " level (" " "UNTIL" " " until_cond)? (" " report_point)?
                    | climb_descend " " "AND" " " "MAINTAIN" " " "FLIGHT" " " "LEVEL" " " fl_value (" " report_point)?
                    | climb_descend " " "TO" " " "AND" " " "MAINTAIN" " " level
                    | climb_descend " " "TO" " " "REACH" " " level " " "AT" " " waypoint
                    | "FURTHER" " " ("DESCENT" | "CLIMB") " " level

// Conditional qualifier for altitude constraints (ICAO Doc 4444 §12.3.3)
until_cond : number_word (" " number_word)* " " "D" " " "M" " " "E"
           | waypoint
           | "ESTABLISHED" " " "ON" " " ("LOCALIZER" | "ILS" | "LOC")

climb_descend : "CLIMB" | "DESCEND" | "CLIMBING" | "DESCENDING"
              | "CLIMB AND MAINTAIN" | "DESCEND AND MAINTAIN"

report_point : "REPORT" " " ("LEAVING" | "REACHING" | "PASSING") " " (level | waypoint)
             | "REPORT" " " waypoint


// §3.2  Heading / Track instructions
// Ref: ICAO Doc 4444 §12.3.6

heading_instr : ("FLY" " " "HEADING" | "HEADING") " " heading_value
              | "HEADING" " " heading_value " " "AFTER" " " waypoint
              | ("TURN" | "TURNING") " " ("LEFT" | "RIGHT") " " ("HEADING" " ")? heading_value
              | ("TURN" | "TURNING") " " ("LEFT" | "RIGHT")
              | "PROCEED" " " "DIRECT" " " waypoint
              | "FLY" " " "DIRECT" " " waypoint
              | "DIRECT" " " waypoint
              | "PROCEEDING" " " "DIRECT" " " waypoint (" " "V" " " "O" " " "R")?
              | "CONTINUE" " " ("LEFT" | "RIGHT") " " "TURN" (" " "HEADING" " " heading_value)?
              | "INTERCEPT" " " ("THE" " ")? ("LOCALIZER" | "ILS" | "LOC") (" " "RUNWAY" " " runway_id)?
              | "INTERCEPT" " " runway_id " " ("LOCALIZER" | "ILS" | "LOC")
              | "INTERCEPT" " " ("THE" " ")? waypoint " " number_word (" " number_word)* " " "RADIAL"
              | "JOIN" " " ("THE" " ")? waypoint " " number_word (" " number_word)* " " "RADIAL"
              | "INTERCEPTING" " " ("THE" " ")? ("LOCALIZER" | "ILS" | "LOC") (" " "RUNWAY" " " runway_id)?
              | "INTERCEPTING" " " runway_id " " ("LOCALIZER" | "ILS" | "LOC")
              | "TO" " " "JOIN" " " ("THE" " ")? ("LOCALIZER" | "ILS" | "LOC")


// §3.3  Speed instructions
// Ref: ICAO Doc 4444 §12.3.7

speed_instr : "REDUCE" " " "SPEED" " " "TO" " " speed_value (" " speed_unit)?
            | "INCREASE" " " "SPEED" " " "TO" " " speed_value (" " speed_unit)?
            | "REDUCE" " " "SPEED" " " "BY" " " speed_value (" " speed_unit)?
            | "REDUCE" " " "TO" " " "MINIMUM" " " "APPROACH" " " "SPEED"
            | "RESUME" " " "NORMAL" " " "SPEED"
            | "MAINTAIN" " " "PRESENT" " " "SPEED"
            | "NO" " " "SPEED" " " "RESTRICTION"
            | "SPEED" " " speed_value (" " speed_unit)?
            | "SPEED" " " "NOT" " " ("ABOVE" | "BELOW") " " speed_value (" " speed_unit)?
            | "MAINTAIN" " " speed_value (" " speed_unit)? " " "OR" " " ("GREATER" | "LESS")
            | "REDUCING" " " "SPEED" " " "TO" " " speed_value (" " speed_unit)?
            | "REDUCING" " " "TO" " " speed_value (" " speed_unit)?
            | "MAINTAIN" " " speed_value (" " speed_unit)?
            | "MAINTAINING" " " speed_value (" " speed_unit)?


// §3.4  Frequency / Contact instructions
// Ref: ICAO Doc 4444 §12.4.2

frequency_instr : "CONTACT" " " ("THE" " ")? facility_short " " frequency_value
                | "CONTACT" " " frequency_value
                | "MONITOR" " " ("THE" " ")? facility_short " " frequency_value
                | "MONITOR" " " frequency_value
                | "FREQUENCY" " " "CHANGE" " " "APPROVED"
                | "REMAIN" " " "THIS" " " "FREQUENCY"

facility_short : facility_word (" " facility_word)?

facility_word : "APPROACH" | "CENTER"     | "TOWER"      | "GROUND"
              | "DEPARTURE"| "ARRIVAL"    | "CONTROL"    | "RADAR"
              | "CLEARANCE"| "DELIVERY"   | "ATIS"       | "UNICOM"
              | "TRACON"
              // US facility names (ICAO Doc 8585 / FAA Order 7340.2)
              | "WASHINGTON" | "BOSTON"   | "DULLES"     | "NATIONAL"
              | "REAGAN"     | "BALTIMORE"| "RICHMOND"   | "NORFOLK"
              | "NEW"        | "YORK"     | "CHICAGO"    | "ATLANTA"
              | "DALLAS"     | "MIAMI"    | "DENVER"     | "SEATTLE"
              | "LOS"        | "ANGELES"  | "CLEVELAND"  | "MINNEAPOLIS"
              | "DETROIT"    | "PITTSBURGH" | "PHILADELPHIA"

frequency_value : /1[0-9]{2}\.[0-9]{1,3}/
                | number_word (" " number_word)* " " ("POINT" | "DECIMAL") " " number_word (" " number_word)*


// §3.5  Clearance instructions
// Ref: ICAO Doc 4444 §12.5

clearance_instr : "CLEARED" " " "TO" " " destination (" " "VIA" " " route)?
                | "CLEARED" " " ("FOR" " ")? ("THE" " ")? approach_type " " "APPROACH" (" " "RUNWAY" " " runway_id)?
                | "CLEARED" " " ("FOR" " ")? ("THE" " ")? "VISUAL" " " ("APPROACH" " ")? ("RUNWAY" " " runway_id)?
                | "CLEARED" " " ("FOR" " ")? "ILS" " " "RUNWAY" " " runway_id
                | "CLEARED" " " "TO" " " "LAND" (" " "RUNWAY" " " runway_id)?
                | "RUNWAY" " " runway_id " " "CLEARED" " " "TO" " " "LAND"
                | "RUNWAY" " " runway_id " " surface_wind_instr " " "CLEARED" " " "TO" " " "LAND"
                | "CLEARED" " " "FOR" " " ("TAKE-OFF" | "TAKEOFF") (" " "RUNWAY" " " runway_id)?
                | "RUNWAY" " " runway_id " " "CLEARED" " " "FOR" " " ("TAKE-OFF" | "TAKEOFF")
                | "CLEARED" " " "VISUAL" " " "APPROACH" " " "RUNWAY" " " runway_id
                | "CLEARED" " " waypoint (" " waypoint)? " " "VISUAL" " " "APPROACH" (" " "RUNWAY" " " runway_id)?
                | "CLEARED" " " "DIRECT" " " waypoint
                | "LANDING" " " "CLEARANCE" (" " "RUNWAY" " " runway_id)?
                | "DEPARTURE" " " "CLEARANCE"
                | "IFR" " " "CLEARANCE" (" " destination)?
                | "RECLEARED" (" " destination)?

destination : /[A-Z]{3,4}/
route       : waypoint (" " waypoint)*


// §3.6  Taxi instructions
// Ref: ICAO Doc 4444 §12.6

taxi_instr : "TAXI" " " ("TO" " ")? location (" " "VIA" " " taxi_route)?
           | "HOLD" " " "SHORT" " " ("OF" " ")? location
           | "HOLD" " " "POSITION"
           | "CONTINUE" " " "TAXI"
           | "EXPEDITE" " " "TAXI"
           | "TAXI" " " "INTO" " " "POSITION" " " "AND" " " "HOLD" (" " runway_id)?
           | "LINE" " " "UP" " " "AND" " " "WAIT" (" " runway_id)?
           | "RUNWAY" " " runway_id " " "LINE" " " "UP" " " "AND" " " "WAIT"
           | "CROSS" " " "RUNWAY" " " runway_id (" " "WITHOUT" " " "DELAY")?
           | "VACATE" " " "THE" " " "RUNWAY" (" " "AND" " " "HOLD")?
           | "VACATE" " " ("VIA" " ")? ("TAXIWAY" " ")? waypoint
           | "PROCEED" " " "TO" " " location

location   : "RUNWAY" " " runway_id | waypoint
taxi_route : location (" " location)*


// §3.7  Takeoff instructions
// Ref: ICAO Doc 4444 §12.7

takeoff_instr : "CLEARED" " " "FOR" " " "TAKEOFF" (" " "RUNWAY" " " runway_id)?
              | "HOLD" " " "SHORT" " " "OF" " " "RUNWAY" " " runway_id
              | "TAKEOFF" " " "IMMEDIATELY"
              | "CANCEL" " " "TAKEOFF" " " "CLEARANCE"


// §3.8  Approach instructions
// Ref: ICAO Doc 4444 §12.8

approach_instr : "EXPECT" " " approach_type " " "APPROACH" (" " "RUNWAY" " " runway_id)?
               | "REPORT" " " ("ESTABLISHED" | "LOCALIZER") (" " "RUNWAY" " " runway_id)?
               | "GO" " " "AROUND" (" " "CLIMB" " " "AND" " " "MAINTAIN" " " level)?
               | "CONTINUE" " " "APPROACH"

approach_type : "ILS" | "LOCALIZER" | "LOC" | "VOR" | "RNAV" | "VISUAL" | "GPS" | "NDB"
              | "I" " " "L" " " "S"


// §3.9  Holding instructions
// Ref: ICAO Doc 4444 §12.9

hold_instr : "HOLD" " " hold_direction " " "OF" " " waypoint (" " hold_turns)?
           | "HOLD" " " waypoint (" " hold_turns)?
           | "CLEARED" " " "TO" " " waypoint " " "HOLD" (" " hold_direction)?
           | "HOLD" " " "POSITION"
           | "EXPECT" " " "FURTHER" " " "CLEARANCE" " " "AT" " " time_value

hold_direction : "NORTH" | "SOUTH" | "EAST" | "WEST"
               | "NORTHEAST" | "NORTHWEST" | "SOUTHEAST" | "SOUTHWEST"
hold_turns     : ("LEFT" | "RIGHT") (" " "HAND" (" " "PATTERN")?)?
time_value     : /[0-9]{4}/


// §3.10  Traffic information
// Ref: ICAO Doc 4444 §12.3.10

traffic_instr : "TRAFFIC" " " clock_position /[ ]O'CLOCK/ (" " distance)? (" " traffic_class)? (" " traffic_action)?
              | "TRAFFIC" " " traffic_description
              | "TRAFFIC" " " distance " " "FROM" " " "TOUCHDOWN" (" " "RUNWAY" " " runway_id)?
              | "TRAFFIC" " " "FROM" " " "TOUCHDOWN" (" " "RUNWAY" " " runway_id)?
              | "TRAFFIC" " " "IS" " " "A" " " traffic_type_desc
              | "TRAFFIC" " " "LANDING" " " "RUNWAY" " " runway_id
              | "TRAFFIC" " " "WILL" " " "LAND" (" " "RUNWAY" " " runway_id)?
              | "TRAFFIC" " " "OVER" " " ("THE" " ")? ("THRESHOLD" | "RUNWAY" " " runway_id)
              | "TRAFFIC" " " "WILL" " " "DEPART" (" " "RUNWAY" " " runway_id)? (" " "AHEAD" " " "OF" " " "YOU")?
              | "TRAFFIC" " " "IS" " " "UNDERWAY"
              | "TRAFFIC" " " clock_position /[ ]O'CLOCK/ " " distance (" " ("TURNING" " ")? direction)?
              | "TRAFFIC" " " clock_position /[ ]O'CLOCK/ (" " distance)? (" " traffic_class)* (" " progressive_traffic_desc)?
              | "TRAFFIC" " " "IN" " " "SIGHT"
              | "TRAFFIC" " " "NO" " " "LONGER" " " "A" " " "FACTOR"
              | "NO" " " "LONGER" " " "A" " " "FACTOR"
              | "NO" " " "REPORTED" " " "TRAFFIC"
              | "NO" " " "TRAFFIC" " " "OBSERVED"

clock_position    : number_word (" " number_word)?
distance          : number_word (" " number_word)* " " ("MILES" | "MILE" | "NM")?
                  | number_word (" " number_word)* " " ("MILES" | "MILE" | "NM") " " "FROM" " " "TOUCHDOWN"
                  | "FROM" " " "TOUCHDOWN"
traffic_class     : "UNKNOWN" | "VFR" | "IFR" | "MILITARY" | "HEAVY" | "SUPER"
traffic_action    : "REPORT" " " "IN" " " "SIGHT" | "IN" " " "SIGHT"
progressive_traffic_desc : ("TURNING" " ")? direction
                         | ("CLIMBING" | "DESCENDING" | "LEVELLING") " " ("FROM" | "TO" | "AT") " " level

traffic_type_desc : waypoint (" " direction)?         // aircraft type e.g. SAAB, DELTA JET
                  | waypoint " " waypoint (" " direction)?
                  | waypoint " " "EIGHTY" (" " direction)?  // MD-80 type (ICAO §12.3.10 traffic advisory)
                  | waypoint " " waypoint " " "EIGHTY" (" " direction)?

traffic_description : "ALERT" | "SEPARATION" " " "LOST" | "CONFLICT"
                    | "SAME" " " "DIRECTION" | "OPPOSITE" " " "DIRECTION"
                    | "CROSSING" | "OVERTAKING"
                    | traffic_class (" " distance)? (" " direction)?

direction : "NORTHBOUND" | "SOUTHBOUND" | "EASTBOUND" | "WESTBOUND"
           | "NORTH" | "SOUTH" | "EAST" | "WEST"
           | "NORTHEAST" | "NORTHWEST" | "SOUTHEAST" | "SOUTHWEST"


// §3.11  Transponder / Radar identification
// Ref: ICAO Doc 4444 §12.3.11

ident_instr : "SQUAWK" " " squawk_code
            | "SQUAWK" " " ("IDENT" | "STANDBY" | "CHARLIE" | "NORMAL")
            | "IDENT"
            | "STOP" " " "SQUAWK"

squawk_code : /[0-7]{4}/ | number_word (" " number_word)*

// §3.10b  Surface wind broadcast (ICAO Doc 4444 §12.8)
surface_wind_instr : "SURFACE" " " "WIND" " " wind_dir " " wind_speed_desc
                   | "SURFACE" " " "WIND" " " "CALM"
wind_dir : number_word (" " number_word)* " " "DEGREES"
         | "VARIABLE"
wind_speed_desc : number_word (" " number_word)* " " ("KNOTS" | "KT")
                | "CALM"                                    // surface wind CALM (ICAO §12.8)


radar_contact_instr : "RADAR" " " "CONTACT" (" " level | " " waypoint)?
                    | "RADAR" " " "CONTACT" " " "LOST"
                    | "RADAR" " " "SERVICE" " " "TERMINATED"

// §3.12  Position reports and readback acknowledgements
// Ref: ICAO Doc 4444 §12.4.1

report_instr : "REPORT" " " report_type

report_type : "PASSING" " " (level | waypoint)
            | "ESTABLISHED" (" " "ON" " " ("LOCALIZER" | "ILS" | "LOC"))?
            | "VISUAL"
            | "DOWNWIND" | "BASE" | "FINAL"
            | "LEAVING" " " level
            | "REACHING" " " level
            | "RUNWAY" " " "VACATED"
            | "RUNWAY" " " "IN" " " "SIGHT"
            | "FIELD" " " "IN" " " "SIGHT"
            | "POSITION"
            | "VISUAL" " " "SEPARATION"


// §3.13  Confirmation requests
// Ref: ICAO Doc 4444 §12.4.4

confirm_instr : "CONFIRM" " " confirm_subject

confirm_subject : "LEVEL" | "ALTITUDE" | "HEADING" | "SPEED" | "SQUAWK" | "CALLSIGN"
                | "SPEED" " " speed_value (" " speed_unit)?
                | "ALTITUDE" " " level
                | "HEADING" " " heading_value
                | "CLIMB" " " "TO" " " level
                | "DESCEND" " " "TO" " " level
                | "DEPARTED" " " waypoint


// §3.14  Route / Airway instructions
// Ref: ICAO Doc 4444 §12.3.8

route_instr : "JOIN" " " airway_id (" " "RESUME" " " "OWN" " " "NAVIGATION")?
            | "RESUME" " " "OWN" " " "NAVIGATION"
            | "PROCEED" " " "VIA" " " route
            | "JOIN" " " ("THE" " ")? ("LOCALIZER" | "ILS" | "LOC")   // join without TO prefix

airway_id : airline_word " " number_word (" " number_word)*   // e.g. JULIETT ONE FOUR NINER (J149)
          | /[A-Z]/ " " number_word (" " number_word)*        // single letter form


// §3.15  ATIS information identifier
// Ref: ICAO Doc 4444 §12.2.2

information_instr : "INFORMATION" " " airline_word   // e.g. INFORMATION VICTOR


// §3.16  Altitude departure report (leaving level climbing/descending)
leaving_instr : "LEAVING" " " level " " ("CLIMBING" | "DESCENDING") " " "TO" " " level


// ── §4  SHARED TERMINALS ───────────────────────────────────────────────────

// §4.1  Altitude / Level
level : "FLIGHT" " " "LEVEL" " " fl_value
      | altitude_value " " ("FEET" | "FT" | "METRES" | "M")
      | altitude_value

fl_value       : /[0-9]{2,3}/ | number_word (" " number_word)*
altitude_value : number_word (" " number_word)* | /[0-9]{1,5}/


// §4.2  Heading
heading_value : /[0-9]{3}/ | number_word (" " number_word)*


// §4.3  Speed
speed_value : number_word (" " number_word)* | /[0-9]{2,3}/
speed_unit  : "KNOTS" | "KT" | "KILOMETRES" " " "PER" " " "HOUR"


// §4.4  Runway
runway_id : /[0-9]{1,2}[LRC]?/
          | number_word (" " number_word)* (" " ("LEFT" | "RIGHT" | "CENTER"))?
          | number_word (" " number_word)* " " airline_word   // named runway (e.g. DAVISON)


// §4.5  Waypoint / Fix identifier
waypoint : /[A-Z]{3,10}/   // ICAO fix names: 3–5 chars; expanded for WASHINGTON, JULIETT
        | /[A-Z]/ " " /[A-Z]/ " " /[A-Z]/   // three-letter phonetic: D F W
        | /[A-Z]/ " " /[A-Z]/                 // two-letter phonetic: I L


// §4.6  Number words (ICAO Doc 4444 §12.2.1 — individual digit pronunciation)
// ICAO §12.2.1: "Numbers shall be transmitted by pronouncing each digit separately."
// Grouped digits (THIRTY, NINETY etc.) are excluded: they are 1994 corpus
// transcription artifacts with no basis in ICAO standard phraseology.
// Exceptions retained with ICAO justification:
//   TEN, ELEVEN, TWELVE — TEN: distance (ICAO §12.3.10); ELEVEN/TWELVE: clock positions (§12.3.10)
//   HUNDRED, THOUSAND   — altitude level expressions (§12.3.1)
//   DECIMAL, POINT      — frequency expressions (§12.4.2)
//   OH                  — informal but operationally pervasive ("ONE OH EIGHT")
//   CALM                — surface wind (§12.8, also in surface_wind_instr)
number_word : "ZERO"  | "ONE"    | "TWO"   | "THREE" | "FOUR"
            | "FIVE"  | "SIX"    | "SEVEN" | "EIGHT" | "NINER"
            | "HUNDRED" | "THOUSAND" | "DECIMAL" | "POINT" | "OH"
            | "TEN"   | "ELEVEN" | "TWELVE"
            | "CALM"                                   // surface wind: CALM (ICAO §12.8)


// §4.7  Callsign
callsign_phrase : spoken_callsign | alpha_callsign

// Alphanumeric callsign: N12345, UAV007, AAL123
alpha_callsign : /[A-Z]{1,3}[-]?[0-9]{1,6}[A-Z]{0,3}/

// Spoken telephony callsign: DELTA SIX (DAL6), NOVEMBER TWO SIX GOLF ALPHA (N26GA)
// Telephony designators per ICAO Doc 8585 / FAA Order 7340.2
spoken_callsign : airline_word (" " number_word)+ (" " "HEAVY")?
                | airline_word (" " airline_word)+ (" " number_word)+ (" " "HEAVY")?
                | airline_word (" " (number_word | airline_word))+ (" " "HEAVY")?
                | alpha_callsign (" " "HEAVY")?

// Telephony designator words (airline names, NATO phonetics, military callsigns)
// Authoritative sources: ICAO Doc 8585, FAA Order 7340.2, FAA JO 7110.65BB App.A
airline_word : "AMERICAN" | "UNITED"    | "DELTA"     | "CONTINENTAL" | "NORTHWEST"
    | "SOUTHWEST" | "EASTERN"  | "WESTERN"   | "BRANIFF"     | "OZARK"
    | "REPUBLIC"  | "PIEDMONT" | "ALLEGHENY" | "MIDWAY"      | "FRONTIER"
    | "ALOHA"     | "HORIZON"  | "SKYWEST"   | "COMAIR"      | "ATLANTIC"
    | "AIR"       | "US"       | "TWA"       | "PAN"
    // International carriers (ICAO Doc 8585)
    | "LUFTHANSA" | "SWISSAIR" | "VIRGIN"    | "CANADA"      | "SPEEDBIRD"
    | "CLIPPER"   | "SHAMROCK" | "ZANTOP"    | "MEXICANA"
    // Regional / charter (FAA Order 7340.2)
    | "HENSON"    | "ASEA"     | "METRO"     | "COMMUTER"    | "SHUTTLE"
    | "EXPRESS"   | "LINK"     | "EAGLE"     | "MOHAWK"      | "NAVAJO"
    | "GULFSTREAM"| "SUNBIRD"  | "HORIZON"   | "JETEX"       | "CHAPARRAL"
    | "MIDEX"     | "BIZEX"    | "LONER"     | "RIPIT"
    // Cargo / charter
    | "FEDERAL"   | "FLIGHT"   | "MEDSTAR"   | "CITATION"
    // Military (FAA JO 7110.65BB)
    | "ARMY"      | "NAVY"     | "MARINE"    | "COAST"       | "GUARD"
    | "PAD"
    | "NIGHTHAWK" | "BOXER"    | "PACER"     | "VENUS"       | "ROSS"
    | "HUSTLER"   | "NASA"     | "CONDOR"    | "BARON"       | "LANCE"
    | "PORT"      | "CARE"     | "MARTINAIRE"| "PAT"         | "RED"
    // General aviation types used as callsigns (FAA JO 7110.65BB)
    | "CESSNA"    | "LEARJET"  | "MOONEY"    | "CHEROKEE"    | "FALCON"
    | "ARROW"     | "MALIBU"   | "SKYLANE"   | "TWIN"        | "KING"
    | "WESTWIND"  | "CROWN"    | "BLUE"      | "RIDGE"       | "BIRD"
    // UAV / emerging operations
    | "UAV"       | "DRONE"
    // NATO phonetic alphabet (ICAO Annex 10, used in callsigns and airways)
    | "ALPHA"     | "BRAVO"    | "CHARLIE"   | "DELTA"       | "ECHO"
    | "FOXTROT"   | "GOLF"     | "HOTEL"     | "INDIA"       | "JULIET"
    | "JULIETT"   | "KILO"     | "LIMA"      | "MIKE"        | "NOVEMBER"
    | "OSCAR"     | "PAPA"     | "QUEBEC"    | "ROMEO"       | "SIERRA"
    | "TANGO"     | "UNIFORM"  | "VICTOR"    | "WHISKEY"     | "XRAY"
    | "YANKEE"    | "ZULU"
    // Single letter (callsign components: T W A, U S AIR)
    | /[A-Z]/
    // Additional LDC corpus callsigns (ICAO Doc 8585 verified)
    | "TRUMP"     | "WAYNE"    | "NERA"      | "PRECISION"   | "REGIONAL"
    | "CACTUS"    | "JET"      | "DEPARTURE" | "WASHINGTON"


// ── §5  PILOT UTTERANCES ───────────────────────────────────────────────────
// Entry point: start='pilot_utterance'
// Key structural distinction from controller utterances:
//   Controller: [callsign] instruction_chain     (callsign BEFORE instructions)
//   Pilot readback: instruction_content callsign (callsign AFTER content)
//   Pilot report:   callsign WITH YOU AT level
//   Pilot request:  [callsign] REQUEST body

pilot_utterance : readback
                | pilot_report
                | pilot_request
                | pilot_contact
                | callsign_phrase          // bare callsign acknowledgement (ICAO Doc 4444 §12.4.1)
                | pilot_general            // disabled in strict mode


// §5.1  Pilot readback
// ICAO Doc 4444 §12.4.1: pilot reads back instruction + appends callsign.
// Abbreviated readbacks are common in operational practice.

readback : readback_body " " callsign_phrase   // ICAO standard: callsign at end
         | readback_body                        // abbreviated (callsign omitted)

readback_body : instruction                     // full repeat of controller instruction
              | readback_modified               // progressive / abbreviated form

readback_modified : ("TURNING" | "TURN") " " ("LEFT" | "RIGHT") (" " "HEADING")? " " heading_value
                  | ("LEFT" | "RIGHT") " " heading_value (" " "FOR")?
                  | "HEADING" " " heading_value
                  | ("CLIMBING" | "DESCENDING") " " "TO" " " level
                  | ("CLIMBING" | "DESCENDING") " " "AND" " " "MAINTAINING" " " level
                  | "LEAVING" " " level " " ("CLIMBING" | "DESCENDING") (" " "TO" " " level)?
                  | "LEVELLING" " " "OFF" (" " "AT" " " level)?
                  | "LEVEL" " " level
                  | "MAINTAINING" " " level
                  | "REDUCING" " " "TO" " " speed_value (" " speed_unit)?
                  | "SLOWING" " " "TO" " " speed_value (" " speed_unit)?
                  | acknowledgment " " instruction   // e.g. "ROGER DESCEND AND MAINTAIN..."


// §5.2  Pilot position report
// ICAO Doc 4444 §12.4.3: callsign + position/level information.

// Ref: ICAO Doc 4444 §12.4.3
pilot_report : callsign_phrase " " "WITH" " " "YOU" (" " "AT" " " level)?
             | callsign_phrase " " pilot_level_report
             | callsign_phrase " " pilot_action_report (" " ("AND" " ")? pilot_action_report)*
             | callsign_phrase " " "FIELD" " " "IN" " " "SIGHT"
             | callsign_phrase " " "RUNWAY" " " "IN" " " "SIGHT"
             | callsign_phrase " " "TRAFFIC" " " "IN" " " "SIGHT"
             | callsign_phrase " " "GOING" " " "AROUND"
             | callsign_phrase " " "MISSED" " " "APPROACH"
             | callsign_phrase " " "LOOKING" " " "OUT"
             | callsign_phrase " " "NEGATIVE" " " "CONTACT"   // traffic not in sight (ICAO §12.3.10)
             | callsign_phrase " " "AIRPORT" " " "IN" " " "SIGHT"
             | callsign_phrase " " pilot_level_report " " "AIRPORT" " " "IN" " " "SIGHT"
             | callsign_phrase " " "RUNWAY" " " "VACATED"
             | callsign_phrase " " "RUNWAY" " " runway_id " " ("LEFT" | "RIGHT" | "CENTER") " " "IN" " " "SIGHT"
             | callsign_phrase " " "RUNWAY" " " runway_id " " "IN" " " "SIGHT"
             | callsign_phrase " " "RUNWAY" " " runway_id " " "VACATED"
             | callsign_phrase " " "READY" " " "FOR" " " "DEPARTURE" (" " "RUNWAY" " " runway_id)?
             | callsign_phrase " " "BEHIND" " " callsign_phrase " " "VISUAL" " " "APPROACH" (" " "RUNWAY" " " runway_id)?
             | callsign_phrase " " "FOLLOWING" " " ("THE" " ")? callsign_phrase (" " "STRAIGHT" " " "IN")? (" " "RUNWAY" " " runway_id)?
             | callsign_phrase " " acknowledgment              // callsign + ROGER/WILCO etc.
             | callsign_phrase " " acknowledgment " " instruction

// Progressive position report — pilot reports current action
// e.g. "DELTA SIX TURNING LEFT HEADING ONE EIGHT ZERO"
// Ref: ICAO Doc 4444 §12.4.3
pilot_action_report : ("TURNING" | "TURN") " " ("LEFT" | "RIGHT") (" " "HEADING")? (" " heading_value)?
                    | "HEADING" " " heading_value
                    | "HEADING" " " heading_value " " "AFTER" " " waypoint
                    | ("CLIMBING" | "DESCENDING") " " "TO" " " level
                    | ("CLIMBING" | "DESCENDING") " " "AND" " " "MAINTAINING" " " level
                    | ("CLIMBING" | "DESCENDING") " " "TO" " " "FLIGHT" " " "LEVEL" " " fl_value
                    | "REDUCING" " " ("SPEED" " ")? "TO" " " speed_value (" " speed_unit)?
                    | "EXPEDITING" " " ("CLIMB" | "DESCENT")
                    | "INTERCEPTING" " " ("THE" " ")? ("LOCALIZER" | "ILS" | "LOC") (" " "RUNWAY" " " runway_id)?
                    | "PROCEEDING" " " "DIRECT" " " waypoint (" " "V" " " "O" " " "R")?
                    | ("TURNING" | "TURN") " " ("LEFT" | "RIGHT") " " heading_value " " ("CLIMBING" | "DESCENDING") " " "TO" " " level
                    | "MAINTAINING" " " level
                    | "MAINTAINING" " " speed_value (" " speed_unit)?
                    | "SPEED" " " speed_value (" " speed_unit)?
                    | "CLEARED" " " ("FOR" " ")? ("THE" " ")? approach_type " " "APPROACH" (" " "RUNWAY" " " runway_id)?
                    | "CLEARED" " " ("FOR" " ")? "THE" " " "APPROACH" (" " "RUNWAY" " " runway_id)?
                    | "CLEARED" " " "FOR" " " ("TAKE-OFF" | "TAKEOFF") (" " "RUNWAY" " " runway_id)?
                    | "LINING" " " "UP" " " "AND" " " ("WAIT" | "WAITING") (" " "RUNWAY" " " runway_id)?
                    | "RUNWAY" " " runway_id " " "LINING" " " "UP" " " "AND" " " ("WAIT" | "WAITING")
                    | "RUNWAY" " " runway_id " " "CLEARED" " " "FOR" " " ("TAKE-OFF" | "TAKEOFF")
                    | "CLEARED" " " "TO" " " "LAND" (" " "RUNWAY" " " runway_id)?
                    | "RUNWAY" " " runway_id " " "CLEARED" " " "TO" " " "LAND"
                    | "CONTACTING" " " facility_short (" " frequency_value)?
                    | "ROLLING" (" " "RUNWAY" " " runway_id)?
                    | "CROSSING" " " "RUNWAY" " " runway_id (" " "CONTACTING" " " facility_short)?
                    | number_word (" " number_word)? " " "MILE" " " "FINAL" (" " "RUNWAY" " " runway_id)?
                    | "TURNING" " " "ONTO" " " "A" " " number_word (" " number_word)? " " "MILE" " " "FINAL"

pilot_level_report : "LEAVING" " " level (" " ("CLIMBING" | "DESCENDING") " " "TO" " " level)?
                   | "PASSING" " " level
                   | "LEVEL" " " level
                   | "AT" " " level
                   | "ESTABLISHED" (" " "ON" " " ("LOCALIZER" | "ILS" | "LOC"))?
                   | "APPROACHING" " " waypoint
                   | "OVER" " " waypoint


// §5.3  Pilot request
// ICAO Doc 4444 §12.4.5: [callsign] REQUEST [item].

// Ref: ICAO Doc 4444 §12.4.5
pilot_request : callsign_phrase " " "REQUEST" " " request_body
              | "REQUEST" " " request_body
              | callsign_phrase " " "CONFIRM" " " confirm_subject
              | "CONFIRM" " " confirm_subject

request_body : instruction
             | "LOWER" | "HIGHER"
             | "DESCENT" " " "TO" " " level
             | "CLIMB" " " "TO" " " level
             | "VECTORS" (" " "TO" " " ("THE" " ")? ("ILS" | "LOCALIZER" | "LOC"))?
             | "DIRECT" " " waypoint
             | "VISUAL" " " "APPROACH" (" " "RUNWAY" " " runway_id)?
             | "CLEARANCE" (" " "TO" " " destination)?
             | "DEVIATION"
             | "WEATHER" " " "DEVIATION"
             | level


// §5.4  Pilot initial contact
// ICAO Doc 4444 §12.4.2: [facility] callsign WITH YOU AT level.

pilot_contact : facility_short " " callsign_phrase (" " "WITH" " " "YOU")? (" " "AT" " " level)?
              | facility_short " " callsign_phrase " " "LEVEL" " " level
              | callsign_phrase " " "WITH" " " facility_short (" " "AT" " " level)?
              | facility_short " " callsign_phrase " " number_word (" " number_word)? " " "MILE" " " "FINAL" (" " "RUNWAY" " " runway_id)?
              | facility_short " " callsign_phrase " " level
              | facility_short " " callsign_phrase " " "VISUAL" " " "APPROACH" (" " "RUNWAY" " " runway_id)?


// §5.5  Pilot catch-all (disabled in strict mode)
// Handles non-standard pilot transmissions for permissive training signal.
pilot_general : /[A-Z']+/ " " /[A-Z']+/ (" " /[A-Z']+/)*


// ── §6  CATCH-ALL FALLBACK (disabled in strict mode) ──────────────────────
// Provides training signal for utterances not covered by the structured rules.
// Disabled during compliance metric computation by the strict parser builder.
general_instr : word (" " word)+
word          : /[A-Z']+/


// ── WHITESPACE ─────────────────────────────────────────────────────────────
%ignore /\n/